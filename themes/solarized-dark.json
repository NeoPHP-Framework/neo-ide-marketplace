    "InputFocusBorder": "#268BD2",
    "LinkFg": "#268BD2",
    "PanelBg": "#00232C",
    "PopupBg": "#00232C",
    "PopupBorder": "#0A3D4A",
    "PressedBg": "#14343B",
    "ScrollThumb": "#254249",
    "ScrollThumbHover": "#334F55",
    "SelectedBg": "#0D4A5A",
