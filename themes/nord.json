    "selection": "#434C5E",
    "lineNumbers": "#4C566A",
    "activeLineNumber": "#D8DEE9",
    "unused": "#616E88",
    "errorUnderline": "#BF616A",
    "bracketMatch": "#4C566A",
    "searchHighlight": "#4C566A",
    "caret": "#D8DEE9"
