    "DocTag": {
      "color": "#81A1C1",
      "bold": true,
      "italic": true
    },
    "Variable": "#D8DEE9",
    "Property": "#8FBCBB",
    "Constant": {
      "color": "#B48EAD",
      "bold": false,
      "italic": true
