    "EditorBg": "#2E3440",
    "ErrorFg": "#F75464",
    "Fg": "#D8DEE9",
    "FgDisabled": "#5F6778",
    "FgSecondary": "#8892A6",
    "HoverBg": "#3B4252",
    "InputBg": "#3B4252",
    "InputBorder": "#555E6F",
    "InputFocusBorder": "#88C0D0",
    "LinkFg": "#96C7D5",
    "PanelBg": "#2E3440",
    "PopupBg": "#2E3440",
