  "syntax": {
    "Default": "#C0CAF5",
    "Keyword": "#BB9AF7",
    "String": "#9ECE6A",
    "StringEscape": "#89DDFF",
    "Number": "#FF9E64",
    "Comment": {
      "color": "#565F89",
      "bold": false,
      "italic": true
