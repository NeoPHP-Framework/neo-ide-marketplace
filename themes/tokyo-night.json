    "selection": "#283457",
    "lineNumbers": "#474E70",
    "activeLineNumber": "#C0CAF5",
    "unused": "#565F89",
    "errorUnderline": "#F7768E",
    "bracketMatch": "#242C48",
    "searchHighlight": "#55473A",
    "caret": "#7AA2F7"
