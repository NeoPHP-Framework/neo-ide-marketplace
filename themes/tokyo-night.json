    "DocTag": {
      "color": "#BB9AF7",
      "bold": true,
      "italic": true
    },
    "Variable": "#C0CAF5",
    "Property": "#73DACA",
    "Constant": {
      "color": "#FF9E64",
      "bold": false,
      "italic": true
    },
    "Function": "#7AA2F7",
    "FunctionCall": "#7AA2F7",
    "StaticCall": {
      "color": "#7AA2F7",
      "bold": false,
      "italic": true
