    "ConsoleBg": "#1A1B26",
    "EditorBg": "#1A1B26",
    "ErrorFg": "#F7768E",
    "Fg": "#C0CAF5",
    "FgDisabled": "#3C425E",
    "FgSecondary": "#565F89",
    "HoverBg": "#24242F",
    "InputBg": "#1A1B26",
    "InputBorder": "#2E2F3C",
    "InputFocusBorder": "#7AA2F7",
    "LinkFg": "#7AA2F7",
    "PanelBg": "#16161E",
    "PopupBg": "#16161E",
    "PopupBorder": "#2E2F3C",
    "PressedBg": "#2D2E3B",
    "ScrollThumb": "#404354",
    "ScrollThumbHover": "#525569",
    "SelectedBg": "#283457",
    "SelectedInactiveBg": "#20263D",
    "SeparatorBrush": "#101016",
    "SubtleBorder": "#2E2F3C",
    "SuccessFg": "#9ECE6A",
    "TabActiveBg": "#1A1B26",
