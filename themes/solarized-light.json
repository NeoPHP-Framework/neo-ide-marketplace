    "DocComment": {
      "color": "#93A1A1",
      "bold": false,
      "italic": true
    },
    "DocTag": {
      "color": "#859900",
      "bold": true,
      "italic": true
    },
    "Variable": "#268BD2",
    "Property": "#268BD2",
    "Constant": {
      "color": "#CB4B16",
      "bold": false,
      "italic": true
